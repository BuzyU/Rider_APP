PORT=3000
LIVEKIT_URL=wss://your-livekit-host.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
API_SECRET=your_backend_api_secret

# ─── Phase 0 / Phase 1 flags ────────────────────────────────────────────────

# ROOM_ID_MODE: when true, LiveKit room name = Room.id (UUID).
# Deploy backend with false first, then flip to true after new APK is live.
ROOM_ID_MODE=false

# LEGACY_CLIENTS_ALLOWED: when false + X-App-Version < MIN_APP_VERSION,
# room/lobby/invite endpoints return 426 Upgrade Required.
# Keep true until the v0.0.3.15 APK is in the hands of all testers.
LEGACY_CLIENTS_ALLOWED=true

# MIN_APP_VERSION: minimum semver that is allowed to use the API.
# Set to 0.0.3.15 after new APK is released.
MIN_APP_VERSION=0.0.3.14

# LIVEKIT_WEBHOOK_ENABLED: enables POST /api/livekit/webhook defence.
# Must also configure the webhook URL in LiveKit Cloud dashboard.
# Format: https://<your-backend>/api/livekit/webhook
LIVEKIT_WEBHOOK_ENABLED=false

# DIAG_CLOSE_GRACE_SECONDS: seconds to wait for all participants to stop
# before force-closing a diagnostic run when the convoy ends.
DIAG_CLOSE_GRACE_SECONDS=90

# Network Diagnostics & Reporting
DIAG_EMAIL_TO=diagnostics@example.com
DIAG_ADMIN_KEY=your_diagnostic_export_admin_key
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=password
SMTP_FROM_NAME="RiderVoice Beta Squad"
SMTP_FROM="RiderVoice Diagnostics" <noreply@example.com>

# Firebase Admin Service Account (Raw JSON string for production; if unset, falls back to local JSON credential file)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# HTTP Request Logging (set to 'true' only for verbose request body/header debugging)
DEBUG_HTTP_LOGGING=false


# Supabase PostgreSQL
SUPABASE_DB_URL=postgresql://user:password@host:port/database
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key


# This was inserted by `prisma init`:
# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# The following `prisma+postgres` URL is similar to the URL produced by running a local Prisma Postgres
# server with the `prisma dev` CLI command, when not choosing any non-default ports or settings. The API key, unlike the
# one found in a remote Prisma Postgres URL, does not contain any sensitive information.

DATABASE_URL="postgresql://user:password@host:port/database"
