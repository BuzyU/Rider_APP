generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id
  email       String?  @unique
  phone       String?  @unique
  handle      String?  @unique
  displayName String?
  bikeModel   String?
  bio         String?
  role        user_role @default(CUSTOMER)
  createdAt   DateTime @default(now())

  sentFriendRequests     Friendship[]  @relation("Requester")
  receivedFriendRequests Friendship[]  @relation("Addressee")
  sentInvites            RideInvite[]  @relation("Inviter")
  receivedInvites        RideInvite[]  @relation("Invitee")
  deviceTokens           DeviceToken[]
  rides                  RideSession[]
  alerts                 EmergencyAlert[] @relation("AlertSender")
  ownedRooms             Room[]        @relation("RoomOwner")
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

enum FriendStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

model Friendship {
  id          String       @id @default(uuid())
  requesterId String
  addresseeId String
  status      FriendStatus @default(PENDING)
  createdAt   DateTime     @default(now())

  requester   User @relation("Requester", fields: [requesterId], references: [id])
  addressee   User @relation("Addressee", fields: [addresseeId], references: [id])
  
  @@unique([requesterId, addresseeId])
  @@index([requesterId, status])
  @@index([addresseeId, status])
}

// Phase 1: RoomStatus enum for explicit lifecycle
enum RoomStatus {
  LOBBY
  ACTIVE
  ENDED
}

model Room {
  id                 String       @id @default(uuid())
  name               String
  status             RoomStatus   @default(LOBBY)
  ownerId            String
  diagnosticsEnabled Boolean      @default(false)
  startedAt          DateTime?
  endedAt            DateTime?
  joinCode           String?      @unique
  // Phase 1.5: optional ride metadata
  origin             String?
  destination        String?
  meetupPoint        String?
  estimatedDurationMin Int?
  createdAt          DateTime     @default(now())
  
  owner          User           @relation("RoomOwner", fields: [ownerId], references: [id])
  invites        RideInvite[]
  alerts         EmergencyAlert[]
  joinTokens     RoomJoinToken[]
  diagnosticRuns DiagnosticRun[]

  // Partial unique: name unique among non-ENDED rooms enforced by DB index (see migration)
  // Cannot use @@unique here because it is conditional; enforced via raw SQL unique index.
  @@index([ownerId])
  @@index([status])
  @@index([name, status])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  REMOVED
  LEFT
}

// Phase 1B: source of a membership row
enum InviteSource {
  HOST_INVITE
  SHARE_LINK
  JOIN_CODE
}

model RoomJoinToken {
  id           String    @id @default(uuid())
  roomId       String
  token        String    @unique
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  createdById  String?
  revokedAt    DateTime?
  maxUses      Int?
  useCount     Int       @default(0)

  room         Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([expiresAt])
}

model RideInvite {
  id          String        @id @default(uuid())
  roomId      String
  inviterId   String
  inviteeId   String
  status      InviteStatus  @default(PENDING)
  source      InviteSource  @default(HOST_INVITE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  room        Room @relation(fields: [roomId], references: [id])
  inviter     User @relation("Inviter", fields: [inviterId], references: [id])
  invitee     User @relation("Invitee", fields: [inviteeId], references: [id])

  // Phase 1B: one membership row per (room, invitee)
  @@unique([roomId, inviteeId])
  @@index([roomId, status])
  @@index([inviteeId, status])
  @@index([inviterId, status])
}

model RideSession {
  id           String         @id @default(uuid())
  riderId      String
  roomName     String?
  clientRideId String?        // Phase 8.5: idempotency key for sync
  startTime    DateTime
  endTime      DateTime?
  distanceKm   Float
  privacyState String         @default("PRIVATE")
  routeJson    String?
  diagnosticsEnabled Boolean  @default(false)
  
  user         User           @relation(fields: [riderId], references: [id])
  events       ConvoyEvent[]

  @@unique([riderId, clientRideId])
  @@index([riderId, startTime(sort: Desc)])
}

model ConvoyEvent {
  id        String   @id @default(uuid())
  rideId    String
  type      String
  lat       Float
  lng       Float
  timestamp DateTime

  ride      RideSession @relation(fields: [rideId], references: [id])

  @@index([rideId])
}

model EmergencyAlert {
  id         String   @id @default(uuid())
  senderId   String
  roomId     String
  roomName   String
  lat        Float?
  lng        Float?
  recipients String[]
  status     String   @default("SENT")
  createdAt  DateTime @default(now())

  sender     User     @relation("AlertSender", fields: [senderId], references: [id])
  room       Room     @relation(fields: [roomId], references: [id])

  @@index([roomName, senderId])
  @@index([senderId])
}

enum user_role {
  CUSTOMER
  ADMIN
}

model admin_settings {
  id         String   @id
  settings   Json
  updated_at DateTime @updatedAt
}

model Waitlist {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("waitlist")
  @@index([email])
}

model TesterApplication {
  id              String   @id @default(uuid())
  name            String
  email           String
  phone           String?
  deviceModel     String?  @map("device_model")
  motorcycleModel String?  @map("motorcycle_model")
  experienceNotes String?  @map("experience_notes")
  apkVersion      String?  @default("v0.0.3.8") @map("apk_version")
  status          String   @default("PENDING")
  downloadCount   Int?     @default(1) @map("download_count")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("tester_applications")
  @@index([email])
  @@index([status])
  @@index([createdAt(sort: Desc)])
}

model DiagnosticRun {
  id           String                  @id @default(uuid())
  convoyId     String
  testNumber   Int
  status       String                  @default("ACTIVE")
  createdAt    DateTime                @default(now())
  closedAt     DateTime?
  emailedAt    DateTime?
  closeAt      DateTime?               // Phase 6.9: persisted grace-close timestamp
  summary      Json?

  room         Room                    @relation(fields: [convoyId], references: [id], onDelete: Cascade)
  participants DiagnosticParticipant[]
  batches      DiagnosticBatch[]

  @@unique([convoyId, testNumber])
  @@index([convoyId, status])
}

model DiagnosticParticipant {
  id          String        @id @default(uuid())
  runId       String
  riderId     String
  handle      String
  joinedAt    DateTime      @default(now())
  stoppedAt   DateTime?
  lastSeq     Int?
  lastBatchAt DateTime      @default(now())

  run         DiagnosticRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, riderId])
  @@index([runId])
  @@index([riderId])
}

model DiagnosticBatch {
  id             String        @id @default(uuid())
  runId          String
  riderId        String
  sequenceNumber Int
  payload        Json
  receivedAt     DateTime      @default(now())

  run            DiagnosticRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, riderId, sequenceNumber])
  @@index([runId, riderId])
}
