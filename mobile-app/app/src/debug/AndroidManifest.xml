            android:name="com.ridervoice.mesh.MeshDebugReceiver"
            android:permission="android.permission.DUMP"
            android:exported="true">
            <intent-filter>
                <action android:name="com.ridervoice.mesh.DEBUG_DUMP_STATE" />
